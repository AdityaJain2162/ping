    <string name="automation_perm_call_msg">Grant Call Phone permission so this automation can place calls automatically when triggered. Without it, the dialer will open and you\'ll need to tap Call manually.</string>
    <string name="automation_perm_sms_title">SMS permission needed</string>
    <string name="automation_perm_sms_msg">Grant Send SMS permission so this automation can send text messages automatically when triggered. Without it, the SMS app will open and you\'ll need to tap Send manually.</string>
