    <string name="onboarding_welcome_desc">Privacy-first reminders and automations. No account, no cloud, no tracking. Everything stays on your device.</string>
    <string name="onboarding_reminders_title">Time &amp; Location Reminders</string>
    <string name="onboarding_reminders_desc">Set time-based alarms, location-based geofence triggers (arrive/leave), or both. Ping will remind you at the right time and place.</string>
    <string name="onboarding_automations_title">Reusable Automations</string>
    <string name="onboarding_automations_desc">Create automations once — call, SMS, open apps, navigate — and link them to any reminder. Triggered automatically when the reminder fires.</string>
